function UpdateUI()
	-- Updates information on the UI

	-- Make sure the UI's on
	if not MeshTool.UI then
		return
	end

	-- Get all meshes
	local Meshes = GetMeshes()
	local MeshParts, OnlyForbidden, RealCount = GetMeshParts()

	-- Identify all common properties
	local MeshType = Support.IdentifyCommonProperty(Meshes, 'MeshType')
	local MeshId = false--= Support.IdentifyCommonProperty(MeshParts, 'MeshId') and Support.IdentifyCommonProperty(Meshes, 'MeshId') or nil
	local TextureId = false --= Support.IdentifyCommonProperty(MeshParts, 'TextureID') and Support.IdentifyCommonProperty(Meshes, 'TextureId') or nil
	local VertexColor = VectorToColor(Support.IdentifyCommonProperty(Meshes, 'VertexColor'))
	
	if #Meshes ~= 0 then
		local CommonMeshId = Support.IdentifyCommonProperty(Meshes, 'MeshId')
		local CommonTextureId = Support.IdentifyCommonProperty(Meshes, 'TextureId')
		
		if MeshId == false or CommonMeshId == MeshId then
			MeshId = CommonMeshId
		end
		
		if TextureId == false or CommonTextureId == TextureId then
			TextureId = CommonTextureId
		end
	end
	
	if #MeshParts ~= 0 then
		local CommonMeshId = Support.IdentifyCommonProperty(MeshParts, 'MeshId')
		local CommonTextureID = Support.IdentifyCommonProperty(MeshParts, 'TextureID')

		if MeshId == false or CommonMeshId == MeshId then
			MeshId = CommonMeshId
		end

		if TextureId == false or CommonTextureID == TextureId then
			TextureId = CommonTextureID
		end
	end
	
	-- Check if there's a file mesh in the selection
	local FileMeshInSelection = false
	for _, Mesh in GetMeshes() do
		if Mesh:IsA("SpecialMesh") and Mesh.MeshType == Enum.MeshType.FileMesh then
			FileMeshInSelection = true
			break
		end
	end

	-- Identify common scales and offsets across axes
	local CommonXScale
	local CommonYScale
	local CommonZScale
	
	local CommonXOffset
	local CommonYOffset
	local CommonZOffset
	
	for Index, Mesh in GetMeshes() do
		if Index == 1 then
			CommonXScale, CommonYScale, CommonZScale = Support.Round(Mesh.Scale.X, 3)
			, Support.Round(Mesh.Scale.Y, 3)
			, Support.Round(Mesh.Scale.Z, 3)

			CommonXOffset, CommonYOffset, CommonZOffset = Support.Round(Mesh.Offset.X, 3)
			, Support.Round(Mesh.Offset.Y, 3)
			, Support.Round(Mesh.Offset.Z, 3)
			
			continue
		end
		
		if not CommonXScale and not CommonYScale and not CommonZScale
			and not CommonXOffset and not CommonYOffset and not CommonZOffset then break end
		
		local XScale, YScale, ZScale = Support.Round(Mesh.Scale.X, 3)
		, Support.Round(Mesh.Scale.Y, 3)
		, Support.Round(Mesh.Scale.Z, 3)

		local XOffset, YOffset, ZOffset = Support.Round(Mesh.Offset.X, 3)
		, Support.Round(Mesh.Offset.Y, 3)
		, Support.Round(Mesh.Offset.Z, 3)
		
		CommonXScale = if CommonXScale ~= XScale then nil else CommonXScale
		CommonYScale = if CommonYScale ~= YScale then nil else CommonYScale
		CommonZScale = if CommonZScale ~= ZScale then nil else CommonZScale
		
		CommonXOffset = if CommonXOffset ~= XOffset then nil else CommonXOffset
		CommonYOffset = if CommonYOffset ~= YOffset then nil else CommonYOffset
		CommonZOffset = if CommonZOffset ~= ZOffset then nil else CommonZOffset
	end

	-- Shortcuts to updating UI elements
	local AddButton = MeshTool.UI.Objects.AddButton
	local RemoveButton = MeshTool.UI.Objects.RemoveButton
	local MeshIdInput = MeshTool.UI.Objects.MeshIdOption.TextBox
	local TextureIdInput = MeshTool.UI.Objects.TextureIdOption.TextBox
	local VertexColorIndicator = MeshTool.UI.Objects.TintOption.Indicator
	local XScaleInput = MeshTool.UI.Objects.ScaleOption.XInput.TextBox
	local YScaleInput = MeshTool.UI.Objects.ScaleOption.YInput.TextBox
	local ZScaleInput = MeshTool.UI.Objects.ScaleOption.ZInput.TextBox
	local XOffsetInput = MeshTool.UI.Objects.OffsetOption.XInput.TextBox
	local YOffsetInput = MeshTool.UI.Objects.OffsetOption.YInput.TextBox
	local ZOffsetInput = MeshTool.UI.Objects.OffsetOption.ZInput.TextBox

	-- Update the inputs
	UpdateDataInputs {
		[MeshIdInput] = MeshId and ParseAssetId(MeshId) or MeshId or '*',
		[TextureIdInput] = TextureId and ParseAssetId(TextureId) or TextureId or '*',
		[XScaleInput] = CommonXScale or '*',
		[YScaleInput] = CommonYScale or '*',
		[ZScaleInput] = CommonZScale or '*',
		[XOffsetInput] = CommonXOffset or '*',
		[YOffsetInput] = CommonYOffset or '*',
		[ZOffsetInput] = CommonZOffset or '*',
	}
	UpdateColorIndicator(VertexColorIndicator, VertexColor)

	-- Update selection state
	local MeshTypeLabel = Support.FindTableOccurrence(MeshTypes, MeshType)
	if MeshTool.CurrentType ~= MeshTypeLabel then
		MeshTool.CurrentType = MeshTypeLabel
		MeshTool.OnTypeChanged:Fire(MeshTypeLabel)
	end

	AddButton.Visible = false
	RemoveButton.Visible = false
	MeshTool.UI.Objects.TypeOption.Visible = false
	MeshIdInput.Parent.Visible = false
	TextureIdInput.Parent.Visible = false
	VertexColorIndicator.Parent.Visible = false
	MeshTool.UI.Objects.ScaleOption.Visible = false
	MeshTool.UI.Objects.OffsetOption.Visible = false
	MeshTool.UI.Objects.ScalingOption.Visible = false
	MeshTool.UI.Objects.ForbiddenNote.Visible = false
	MeshTool.UI.Objects.SelectNote.Visible = false
	
	-- Define the different available layouts depending on the meshes' nature
	local Layouts = {
		-- If a part lacks a mesh
		NoMesh = { AddButton },
		-- If a part has a mesh
		HasAMesh = { MeshTool.UI.Objects.TypeOption, MeshTool.UI.Objects.ScaleOption, MeshTool.UI.Objects.OffsetOption },
		-- If a part has a mesh that's a file mesh
		IsAFileMesh = { VertexColorIndicator.Parent },
		-- If a part can have a MeshId and a TextureId (MeshParts and FileMeshes)
		CanAcceptId = { Core.Options.BetterMeshSizeControl and MeshTool.UI.Objects.ScalingOption or nil, MeshIdInput.Parent, TextureIdInput.Parent }
	}
	
	-- Update the UI to display options depending on the mesh type
	local DisplayedItems = {}
	
	-- Add the HasAMesh layout when at least one part has a mesh
	if #Meshes ~= 0 then
		Support.ConcatTable(DisplayedItems, Layouts.HasAMesh)
	end
	
	-- Add the IsAFileMesh layout when at least one part has a FileMesh
	if #Meshes ~= 0 and FileMeshInSelection then
		Support.ConcatTable(DisplayedItems, Layouts.IsAFileMesh)
	end
	
	-- Add the IsAFileMesh layout when at least one part has a FileMesh
	if #MeshParts ~= 0 or #Meshes ~= 0 and FileMeshInSelection then
		Support.ConcatTable(DisplayedItems, Layouts.CanAcceptId)
	end
	
	-- Add the NoMesh layout when at least one part lacks a mesh or isn't a MeshPart
	if #Meshes + #MeshParts ~= #Selection.Parts and RealCount ~= #Selection.Parts then
		Support.ConcatTable(DisplayedItems, Layouts.NoMesh)
	end
	
	if #Meshes ~= 0 then
		table.insert(DisplayedItems, RemoveButton)
	elseif #Selection.Parts == 0 then
		DisplayedItems = { MeshTool.UI.Objects.SelectNote }
	end
	
	if OnlyForbidden then
		table.insert(DisplayedItems, 1, MeshTool.UI.Objects.ForbiddenNote)
	end


	
	--[[
	if #Meshes == 0 then
		DisplayedItems = { AddButton }

	-- Each selected part has a mesh, including a file mesh
	elseif #Meshes == #Selection.Parts and FileMeshInSelection then
		DisplayedItems = { MeshTool.UI.TypeOption, Core.Options.BetterMeshSizeControl and MeshTool.UI.ScalingOption or nil, MeshTool.UI.ScaleOption, MeshTool.UI.OffsetOption, MeshIdInput.Parent, TextureIdInput.Parent, VertexColorIndicator.Parent, RemoveButton }
	-- Each selected part has a mesh
	elseif #Meshes == #Selection.Parts and not FileMeshInSelection then
		DisplayedItems = { MeshTool.UI.TypeOption, MeshTool.UI.ScaleOption, MeshTool.UI.OffsetOption, RemoveButton }

	-- Only some selected parts have meshes, including a file mesh
	elseif #Meshes ~= #Selection.Parts and FileMeshInSelection then
		DisplayedItems = { AddButton, MeshTool.UI.TypeOption, Core.Options.BetterMeshSizeControl and MeshTool.UI.ScalingOption or nil, MeshTool.UI.ScaleOption, MeshTool.UI.OffsetOption, MeshIdInput.Parent, TextureIdInput.Parent, VertexColorIndicator.Parent, RemoveButton }
	-- Only some selected parts have meshes
	elseif #Meshes ~= #Selection.Parts and not FileMeshInSelection then
		DisplayedItems = { AddButton, MeshTool.UI.TypeOption, MeshTool.UI.ScaleOption, MeshTool.UI.OffsetOption, RemoveButton }

	end]]

	-- Display the relevant UI elements
	DisplayLinearLayout(DisplayedItems, MeshTool.UI.Objects, UDim2.new(0, 0, 0, 0), 10)

end

function HideUI()
	-- Hides the tool UI

	-- Make sure there's a UI
	if not MeshTool.UI then
		return
	end

	-- Hide the UI
	MeshTool.UI.Visible = false

	-- Stop updating the UI
	UIUpdater:Stop()

end

function GetMeshes()
	-- Returns all the meshes in the selection

	local Meshes = {}

	-- Get any meshes from any selected parts
	for _, Part in pairs(Selection.Parts) do
		local Mesh = Support.GetChildOfClass(Part, 'SpecialMesh')
		
		if Mesh and not Mesh:HasTag("FORK3X_FakeInstance") then
			table.insert(Meshes, Support.GetChildOfClass(Part, 'SpecialMesh'))
		end
	end

	-- Return the meshes
	return Meshes
end

function GetMeshParts()
	local MeshParts = {}
	local OnlyForbidden
	
	local RealCount = 0

	for _, Part in Selection.Parts do
		if Part:IsA("MeshPart") then
			RealCount += 1
			
			if Part:HasTag("BT_CanModifyMeshPart") then
				OnlyForbidden = false
			
				table.insert(MeshParts, Part)
			elseif OnlyForbidden == nil then
				OnlyForbidden = true
			end
		end
	end
	
	return MeshParts, OnlyForbidden, RealCount
end



function ParseAssetId(Input)
	-- Returns the intended asset ID for the given input

	-- Get the ID number from the input
	local Id = tonumber(Input)
		or tonumber(Input:lower():match('%?id=([0-9]+)'))
		or tonumber(Input:match('/([0-9]+)/'))
		or tonumber(Input:lower():match('rbxassetid://([0-9]+)'))

	-- Return the ID
	return Id
end

function VectorToColor(Vector)
	-- Returns the Color3 with the values in the given Vector3

	-- Make sure that the given Vector3 is valid
	if not Vector then return end

	-- Return the Color3
	return Color3.new(Vector.X, Vector.Y, Vector.Z)
end

function ColorToVector(Color)
	-- Returns the Vector3 with the values in the given Color3

	-- Make sure that the given Color3 is valid
	if not Color then return end

	-- Return the Vector3
	return Vector3.new(Color.r, Color.g, Color.b)
end

function UpdateDataInputs(Data)
	-- Updates the data in the given TextBoxes when the user isn't typing in them

	-- Go through the inputs and data
	for Input, UpdatedValue in pairs(Data) do

		-- Makwe sure the user isn't typing into the input
		if not Input:IsFocused() then

			-- Set the input's value
			Input.Text = tostring(UpdatedValue)

		end

	end

end

function UpdateColorIndicator(Indicator, Color)
	-- Updates the given color indicator

	-- If there is a single color, just display it
	if Color then
		Indicator.BackgroundColor3 = Color
		Indicator.Varies.Text = ''

	-- If the colors vary, display a * on a gray background
	else
		Indicator.BackgroundColor3 = Color3.new(222/255, 222/255, 222/255)
		Indicator.Varies.Text = '*'
	end

end

function DisplayLinearLayout(Items, Container, StartPosition, Padding)

	-- Keep track of the total vertical extents of all items
	local Sum = 0

	-- Go through each item
	for ItemIndex, Item in next, Items do

		-- Make the item visible
		Item.Visible = true

		-- Position this item underneath the past items
		Item.Position = StartPosition + UDim2.new(
			Item.Position.X.Scale,
			Item.Position.X.Offset,
			0,
			Sum + Padding
		)

		-- Update the sum of item heights
		Sum = Sum + Padding + Item.AbsoluteSize.Y

	end

	-- Resize the container to fit the new layout
	Container.CanvasSize = UDim2.new(1, 0, 0, Sum + 5)
	
	local SizeConstraint = Container.Parent.UISizeConstraint
	
	SizeConstraint.MaxSize = Vector2.new(math.huge, Sum + 35)
end

function AddMeshes()

	-- Prepare the change request for the server
	local Changes = {}
	
	-- Create temporary special meshes to reduce latency impact
	local FakeMeshes = {}

	-- Go through the selection
	for _, Part in pairs(Selection.Parts) do

		-- Make sure this part doesn't already have a mesh
		if not Support.GetChildOfClass(Part, 'SpecialMesh') then

			-- Queue a mesh to be created for this part
			table.insert(Changes, { Part = Part })
			
			-- Create a temporary mesh
			local Mesh = Instance.new('SpecialMesh', Part);
			Mesh:AddTag("FORK3X_FakeInstance")
			FakeMeshes[Part] = Mesh
		end

	end

	-- Send the change request to the server
	local Success, Meshes = pcall( Core.SyncAPI.Invoke, Core.SyncAPI, 'CreateMeshes', Changes )

	-- Put together the history record
	local HistoryRecord = {
		Meshes = Meshes,
		Selection = Selection.Items,

		Unapply = function (Record)
			-- Reverts this change

			-- Select changed parts
			Selection.Replace(Record.Selection)

			-- Remove the meshes
			Core.SyncAPI:Invoke('Remove', Record.Meshes)

		end,

		Apply = function (Record)
			-- Reapplies this change

			-- Restore the meshes
			Core.SyncAPI:Invoke('UndoRemove', Record.Meshes)

			-- Select changed parts
			Selection.Replace(Record.Selection)

		end,

	}

	-- Register the history record
	Core.History.Add(HistoryRecord)
	
	for Part, FakeMesh in FakeMeshes do
		FakeMesh:Destroy()
	end

end

function RemoveMeshes()

	-- Get all the meshes in the selection
	local Meshes = GetMeshes()

	-- Create the history record
	local HistoryRecord = {
		Meshes = Meshes,
		Selection = Selection.Items,

		Unapply = function (Record)
			-- Reverts this change

			-- Restore the meshes
