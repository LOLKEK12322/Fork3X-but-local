	local PreferredInput = UserInputService.PreferredInput
	local XReleased = Signal.new()
	
	if Core.IsGamepad() then
		Core.SinkInput(true)
		
		pcall(function() game:GetService("GamepadService"):EnableGamepadCursor( Core.GetInputSink() ) end)
		
