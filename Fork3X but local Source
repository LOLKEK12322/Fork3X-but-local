					[Enum.UserInputType.MouseButton1] = true,
					[Enum.KeyCode.ButtonX] = true,
				}

				Core.SinkInput(true)

				local InputSink = Core.GetInputSink()

				Connections.SnappingButtonInput = InputSink.InputBegan:Connect(function(InputObject)
					if Connections.SnappingButtonInput then
						Connections.SnappingButtonInput:Disconnect()
						Connections.SnappingButtonInput = nil
					end

					if AllowedInputs[InputObject.UserInputType] or AllowedInputs[InputObject.KeyCode] then
						Snap = true
					end

					SnappingChanged:Fire()
				end)

				SnappingChanged:Wait()

				if Snap == false then
					return
				end

				StartSnapping()
			end
		end,
		Size = UDim2.new(0.55, 0, 0.55, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
	}
}

function RotateTool.Equip()
	-- Enables the tool's equipped functionality

	-- Start up our interface
	ShowUI()
	BindShortcutKeys()
	
	-- Set our current pivot mode
	SetPivot(RotateTool.Pivot)

end

function RotateTool.Unequip()
	-- Disables the tool's equipped functionality

	-- Clear unnecessary resources
	HideUI()
	HideHandles()
	ClearConnections()
	
	for Name in Buttons do
		Core.RemoveMobileButton(Name)
	end
	
	BoundingBox.ClearBoundingBox()
	SnapTracking.StopTracking()

end

function ClearConnections()
	-- Clears out temporary connections

	for ConnectionKey, Connection in pairs(Connections) do
		Connection:Disconnect()
		Connections[ConnectionKey] = nil
	end

end

function ClearConnection(ConnectionKey)
	-- Clears the given specific connection

	local Connection = Connections[ConnectionKey]

	-- Disconnect the connection if it exists
	if Connections[ConnectionKey] then
		Connection:Disconnect()
		Connections[ConnectionKey] = nil
	end

end

function SetUpConnections()
	-- Update the UI every 0.1 seconds
	UIUpdater = Support.ScheduleRecurringTask(UpdateUI, 0.1)

	-- Set up scroll stepping if necessary
	if Core.Services.UserInputService.PreferredInput == Enum.PreferredInput.KeyboardAndMouse then

		Connections.ScrollStep = RotateTool.ScrollStepChanged:Connect(function(ScrollStep)

			RotateTool.ScrollStepIndicator.Visible = ScrollStep

			if ScrollStep then
				RotateTool.ScrollStepIndicator.Text = "△: " .. RotateTool.Increment
				RotateTool.ScrollStepIndicator.Position = UDim2.fromOffset(Core.Mouse.X - 5, Core.Mouse.Y + 19)

				Connections.UpdateIndicator = RotateTool.IncrementChanged:Connect(function(Increment)
					RotateTool.ScrollStepIndicator.Text = "△: " .. Increment
					RotateTool.UI.IncrementOption.Increment.TextBox.Text = Increment
				end)
				
				Connections.UpdatePosition = Support.AddUserInputListener("Changed", "MouseMovement", true, function()
					RotateTool.ScrollStepIndicator.Position = UDim2.fromOffset(Core.Mouse.X - 5, Core.Mouse.Y + 19)
				end)
			else
				ClearConnection("UpdateIndicator")

				ClearConnection("UpdatePosition")
			end
		end)
	end
end

