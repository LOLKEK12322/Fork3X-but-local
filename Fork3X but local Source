		end

		-- If - key was released, focus on increment input
		if (InputInfo.KeyCode.Name == 'Minus') or (InputInfo.KeyCode.Name == 'KeypadMinus') then
			if RotateTool.UI then
				RotateTool.UI.IncrementOption.Increment.TextBox:CaptureFocus()
			end
			
		-- Enable scroll step if Shift is held
		elseif InputInfo.KeyCode == Enum.KeyCode.LeftShift or InputInfo.KeyCode == Enum.KeyCode.RightShift then
			RotateTool.ScrollStepChanged:Fire(false)
		end
	end)
	
	-- Track mouse scrolling so we can use scroll step
	RotateTool.MouseScrollDetection = ContextActionService:BindAction("BT: Scroll step", function(ActionName, State, InputInfo)
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) 
			or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then

			local IsUp = InputInfo.Position.Z > 0

			if IsUp then
				RotateTool.Increment = math.max(RotateTool.ScrollStep, RotateTool.Increment + RotateTool.ScrollStep)
			else
				RotateTool.Increment = math.max(RotateTool.ScrollStep, RotateTool.Increment - RotateTool.ScrollStep)
			end
			
			RotateTool.Increment = Support.Round(RotateTool.Increment, 4)

			RotateTool.IncrementChanged:Fire(RotateTool.Increment)

			return Enum.ContextActionResult.Sink
		end

		return Enum.ContextActionResult.Pass

	end, false, Enum.UserInputType.MouseWheel)
	

	for Name, Data in Buttons do
		Core.AddMobileButton(Name, Data)
	end
