local ScheduledThread

function RegisterChange(IsTextModified)
	-- Finishes creating the history record and registers it

	-- Make sure there's an in-progress history record
	if not HistoryRecord then
		return
	end
	
	local Success, EventualError
	
	-- NOTE FOR ROBLOX MODERATORS:
	-- It's unlikely this piece of code may be read, but I (@Vikko151) still think this is important to highlight
	-- On the client, text editing is done instantly to prevent disruptions and allow users to correct typos easily
	-- HOWEVER, the text is replicated to other clients according to the one minute cooldown for TextChatService
	-- This allows them to correct typos, that will be rendered to the other clients the next minute
	-- This check is done on the client (to prevent useless remotes sent), and on the server to prevent bypasses
	-- Please do not take down games with this. They're fully compliant, and I simply wanted to find a less disturbing way to comply
	if Core.Plugin or not IsTextModified or os.clock() - LastEdit >= 60 then
		LastEdit = os.clock()
		
		-- Send the change to the server
		Success, EventualError = pcall( Core.SyncAPI.Invoke, Core.SyncAPI, 'SyncText', HistoryRecord.After )

	elseif IsTextModified then
		for _, Change in HistoryRecord.After do
			ScheduledChanges[Change.Surface] = Change
		end
		
		if not ScheduledThread then
			ScheduledThread = task.delay( 61 - os.clock() + LastEdit, function()
				ScheduledThread = nil
				
				local Changes = {}
				
				for Surface, Change in ScheduledChanges do
					table.insert(Changes, Change)
				end
				
				LastEdit = os.clock()
				
				Core.SyncAPI:Invoke('SyncText', Changes)
			end)
		end
		
		Success = true
	end
	
	if Success then
		-- Register the record and clear the staging
		Core.History.Add(HistoryRecord)
	else
		warn("[FORK3X]: An error occured when using the Text Tool: " 
			.. EventualError
			.. "\n\nIf this isn't a modified version of Fork3X, please report this error to the creator.")
	end
	
	HistoryRecord = nil

	return Success
end

