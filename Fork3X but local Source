		for _, Change in pairs(Changes) do
			if Change.Part then
				ChangeSet[Change.Part] = Change;
			end;
		end;

		-- Make a list of allowed texture type requests
		local AllowedTextureTypes = { Texture = true, Decal = true };

		-- Keep track of the newly created textures
		local Textures = {};

		-- Create each texture
		for Part, Change in pairs(ChangeSet) do

			-- Make sure the requested light type is valid
			if AllowedTextureTypes[Change.TextureType] then
				
				if Change.Face == "All" then
					-- Before creating decals, analyse the current children, and
					-- see where we have or don't have to create decals
					local ConcernedSurfaces = SyncModule.Support.FlipTable( Enum.NormalId:GetEnumItems() )
					local PartTextures = Part:QueryDescendants(">Decal,>Texture")
					
					-- Go through every texture, and take sides out when applicable
					for _, Texture in PartTextures do
						ConcernedSurfaces[Texture.Face] = nil
					end
					
					for Face in ConcernedSurfaces do
						-- Create the texture
						local Texture = Instance.new(Change.TextureType, Part);
						Texture.Face = Face;
						table.insert(Textures, Texture);

						-- Register the texture
						SyncModule.CreatedInstances[Texture] = Texture;
					end
				else
					-- Create the texture
					local Texture = Instance.new(Change.TextureType, Part);
					Texture.Face = Change.Face;
					table.insert(Textures, Texture);

					-- Register the texture
					SyncModule.CreatedInstances[Texture] = Texture;
				end
				
			end;

		end;

		-- Return the new textures
		return Textures;

	end;

