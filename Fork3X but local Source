local EnumCache = {}
local FailedProperties = 0

--[[ Режим загрузки скриптов:
     "virtual" — исходники храним в SOURCES и грузим своим загрузчиком (loadstring),
                 свойство .Source не трогаем вообще;
     "source"  — резервный путь: пишем .Source и грузим родным require. ]]
local LoadMode = "virtual"
local function SetLoadMode(mode)
	LoadMode = mode
end

local SOURCES = {}

local function enumItem(EnumName, value)
	local cache = EnumCache[EnumName]
	if not cache then
		cache = {}
		for _, item in ipairs(Enum[EnumName]:GetEnumItems()) do
			cache[item.Value] = item
		end
		EnumCache[EnumName] = cache
	end
	return cache[value]
end

local function numbers(list)
	local out = {}
	local index = 0
	for piece in string.gmatch(list .. ",", "([^,]*),") do
		index += 1
		out[index] = tonumber(piece) or 0
	end
	return out
end

local function setProperty(instance, info, value)
	local name, kind = info[1], info[2]

	if kind == 1 then
		instance[name] = (value == "1")
	elseif kind == 2 then
		instance[name] = tonumber(value) or 0
	elseif kind == 3 then
		instance[name] = value
	elseif kind == 4 then
		local item = enumItem(info[3], tonumber(value))
		if item then
			instance[name] = item
		end
	elseif kind == 5 then
		local c = numbers(value)
		instance[name] = Color3.new(c[1] or 0, c[2] or 0, c[3] or 0)
	elseif kind == 6 then
		local c = numbers(value)
		instance[name] = UDim2.new(c[1] or 0, c[2] or 0, c[3] or 0, c[4] or 0)
	elseif kind == 7 then
		local c = numbers(value)
		instance[name] = UDim.new(c[1] or 0, c[2] or 0)
	elseif kind == 8 then
		local c = numbers(value)
		instance[name] = Vector2.new(c[1] or 0, c[2] or 0)
	elseif kind == 9 then
		local c = numbers(value)
		instance[name] = Vector3.new(c[1] or 0, c[2] or 0, c[3] or 0)
	elseif kind == 10 then
		local c = numbers(value)
		instance[name] = Rect.new(c[1] or 0, c[2] or 0, c[3] or 0, c[4] or 0)
	elseif kind == 11 then
		local c = numbers(value)
		instance[name] = NumberRange.new(c[1] or 0, c[2] or 0)
	elseif kind == 12 then
		local family, weight, style = string.match(value, "^([^|]*)|([^|]*)|([^|]*)")
		instance[name] = Font.new(
			family or "rbxasset://fonts/families/SourceSansPro.json",
			enumItem("FontWeight", tonumber(weight) or 400) or Enum.FontWeight.Regular,
			Enum.FontStyle[style or "Normal"] or Enum.FontStyle.Normal
		)
	elseif kind == 13 then
		local c = numbers(value)
		instance[name] = Color3.fromRGB(c[1] or 0, c[2] or 0, c[3] or 0)
	end
end

local function applyProperties(instance, list)
	for index = 1, #list, 2 do
		local info = PROPERTIES[list[index]]
		if info then
			local ok = pcall(setProperty, instance, info, list[index + 1])
			if not ok then
				FailedProperties += 1
			end
		end
	end
end

--[[ Свойства StyleRule и атрибуты инстансов.

Entry format: {name, type_code, values...}.

Attribute codes:  1 string, 2 bool, 3 number, 4 UDim, 5 UDim2, 6 Color3,
                  7 Vector2, 8 Vector3, 9 Font, 10 Enum.
Style codes:      1 string, 2 bool, 3 number, 4 UDim, 5 UDim2, 6 Color3,
                  7 Vector2, 8 Enum  <-- different from attributes! ]]

local function enumItem(EnumTypeName, EnumValue)
	local EnumType = Enum[EnumTypeName]
	if not EnumType then
		return nil
	end
	for _, Item in ipairs(EnumType:GetEnumItems()) do
		if Item.Value == EnumValue then
			return Item
		end
	end
	return nil
end

local VALUE_BUILDERS = {
	[1] = function(e) return e[3] end,
	[2] = function(e) return e[3] end,
	[3] = function(e) return e[3] end,
	[4] = function(e) return UDim.new(e[3], e[4]) end,
	[5] = function(e) return UDim2.new(e[3], e[4], e[5], e[6]) end,
	[6] = function(e) return Color3.new(e[3], e[4], e[5]) end,
	[7] = function(e) return Vector2.new(e[3], e[4]) end,
	[8] = function(e) return Vector3.new(e[3], e[4], e[5]) end,
	[9] = function(e)                 -- Font: family + weight + style
		local weight, style = nil, nil
		pcall(function()
			for _, item in ipairs(Enum.FontWeight:GetEnumItems()) do
				if item.Value == e[3] then
					weight = item
				end
			end
			for _, item in ipairs(Enum.FontStyle:GetEnumItems()) do
				if item.Value == e[4] then
					style = item
				end
			end
		end)
		local ok, font = pcall(Font.new, e[5], weight, style)
		return ok and font or nil
	end,
	[10] = function(e)
		return enumItem(e[3], e[4])
	end,
}

-- В стилях код 8 — это Enum (в атрибутах 8 — Vector3), поэтому набор свой.
local STYLE_BUILDERS = {
	[1] = VALUE_BUILDERS[1],
	[2] = VALUE_BUILDERS[2],
	[3] = VALUE_BUILDERS[3],
	[4] = VALUE_BUILDERS[4],
	[5] = VALUE_BUILDERS[5],
	[6] = VALUE_BUILDERS[6],
	[7] = VALUE_BUILDERS[7],
	[8] = function(e)
		return enumItem(e[3], e[4])
	end,
}

local AttributesApplied, AttributeFailures = 0, 0
local TagsApplied, TagFailures = 0, 0
local StylesApplied, StyleFailures = 0, 0

local function applyAttributes(instance, attrs)
	for _, entry in ipairs(attrs) do
		local build = VALUE_BUILDERS[entry[2]]
		if build then
			local ok = pcall(function()
				local value = build(entry)
				if value ~= nil then
					instance:SetAttribute(entry[1], value)
					AttributesApplied += 1
				end
			end)
			if not ok then
				AttributeFailures += 1
			end
		end
	end
end

local function applyTags(instance, tags)
	local service = nil
	pcall(function()
		service = game:GetService("CollectionService")
	end)
	for _, tag in ipairs(tags) do
		local ok = pcall(function()
			if service then
				service:AddTag(instance, tag)
			else
				instance:AddTag(tag)
			end
		end)
		if ok then
			TagsApplied += 1
		else
			TagFailures += 1
		end
	end
end

-- Переменные темы ($TextColor и т.п.) лежат атрибутами на StyleSheet.
local function sheetVariable(instance, name)
	local current = instance
	while current do
		if current:IsA("StyleSheet") then
			local value = current:GetAttribute(name)
			if value ~= nil then
				return value
			end
		end
		current = current.Parent
	end
	return nil
end

--[[ Значения стилей кладём в StyleRule «как есть»: движок Roblox сам разворачивает
     ссылки на токены вида "$TextColor" (они живут атрибутами на StyleSheet токенов).
     Важно только одно: тип варианта должен совпадать с типом свойства, иначе при
     применении правила движок пишет "Variant cast failed". Раньше значения-перечисления
     уходили как Vector3 (код 8 в стилях — это Enum, а не Vector3) — отсюда были сотни
     ошибок про TextXAlignment, FillDirection, SortOrder и т.п. ]]
local function applyStyle(instance, style)
	for _, entry in ipairs(style) do
		local build = STYLE_BUILDERS[entry[2]]
		if build then
			local Ok, Value = pcall(build, entry)
			if Ok and Value ~= nil then
				local SetOk = pcall(function()
					instance:SetProperty(entry[1], Value)
				end)
				if SetOk then
					StylesApplied += 1
				else
					StyleFailures += 1
				end
			else
				StyleFailures += 1
			end
		end
	end
end

-- Не все классы можно создать на клиенте (например, серверные): тогда подставляем
-- папку с тем же именем, чтобы дерево всё равно собралось и код не падал.
local function createInstance(className)
	local ok, instance = pcall(Instance.new, className)
	if ok and instance then
		return instance
	end
	FailedProperties += 1
	local fallback = Instance.new("Folder")
	fallback.Name = className
	return fallback
end

local PendingRefs = {}
local ReferentById = {}

local function build(data, parent)
	local instance = createInstance(CLASSES[data[1]])

	local meta = data[4]
	local source, attrs, style, tags, refs, referent = false, nil, nil, nil, nil, nil
	if type(meta) == "table" then
		source, attrs, style, tags, refs, referent = meta[1], meta[2], meta[3], meta[4], meta[5], meta[6]
	elseif meta then
		source = meta
	end

	if source then
		if LoadMode == "virtual" or LoadMode == "wrap" then
			SOURCES[instance] = source
		else
			pcall(function()
				instance.Source = source
			end)
		end
	end

	applyProperties(instance, BASEPROPS[data[1]])
	applyProperties(instance, data[3])

	instance.Name = data[2]

	if referent then
		ReferentById[referent] = instance
	end
	if refs then
		PendingRefs[instance] = refs
	end
	if attrs then
		applyAttributes(instance, attrs)
	end
	if tags then
		applyTags(instance, tags)
	end
	if style then
		applyStyle(instance, style)
	end

	-- Скрипты внутри инструмента не должны запускаться сами: всё грузит наш загрузчик.
	pcall(function()
		if instance:IsA("BaseScript") then
			instance.Disabled = true
		end
	end)

	for index = 5, #data do
		build(data[index], instance)
	end

	if parent then
		instance.Parent = parent
	end

	return instance
end

local function resolveRefs()
	for instance, refs in pairs(PendingRefs) do
		for _, pair in ipairs(refs) do
			local target = ReferentById[pair[2]]
			if target then
				pcall(function()
					instance[pair[1]] = target
				end)
			end
		end
	end
	table.clear(PendingRefs)
end

local function getCounters()
	return AttributesApplied, AttributeFailures, TagsApplied, TagFailures, StylesApplied, StyleFailures
end



--[[ Сборка инструмента и запуск настоящего ядра Fork3X. ]]

local Started = os.clock()

print("[F3X] Fork3X 3.3.0 local · BUILD v6.2 · .Source is not used · themes + tags applied")

--[[ Загрузка модулей без .Source.

В клиентском скрипте писать ModuleScript.Source нельзя (а во многих экзекьюторах —
нельзя вообще), поэтому исходники каждого модуля лежат в таблице SOURCES, а сам
модуль выполняется нашим загрузчиком через loadstring в отдельном окружении, где
`script` — это нужный инстанс, а `require` — тот же загрузчик. ]]

local ScriptGlobals = (type(getfenv) == "function" and getfenv(1)) or _G
local RealRequire = ScriptGlobals.require

-- Режим загрузки:
--   virtual — loadstring + setfenv (полная изоляция модулей, как в Roblox);
--   wrap    — loadstring без setfenv (script/require передаём параметрами);
--   source  — .Source + родной require (резерв, если loadstring недоступен).
local LOAD_MODE
if type(loadstring) == "function" and type(setfenv) == "function" then
	LOAD_MODE = "virtual"
elseif type(loadstring) == "function" then
	LOAD_MODE = "wrap"
else
	LOAD_MODE = "source"
end

SetLoadMode(LOAD_MODE)

local ModuleCache, ModuleLoaded = {}, {}
local ModulesLoaded = 0

local function LoadModule(Module)
	if ModuleLoaded[Module] then
		return ModuleCache[Module]
	end

	if LOAD_MODE == "source" then
		local Result = RealRequire(Module)
		ModuleCache[Module], ModuleLoaded[Module] = Result, true
		ModulesLoaded += 1
		return Result
	end

	local SourceText = SOURCES[Module]
	if not SourceText then
		error("require: no source for " .. tostring(Module), 2)
	end

	local Run

	if LOAD_MODE == "virtual" then
		local Chunk, LoadError = loadstring(SourceText, "=" .. tostring(Module.Name))
		if not Chunk then
			error("require(" .. tostring(Module.Name) .. "): " .. tostring(LoadError), 2)
		end
		local Environment = setmetatable({ script = Module }, { __index = ScriptGlobals })
		Environment.require = LoadModule
		Environment.script = Module
		setfenv(Chunk, Environment)
		Run = Chunk
	else
		-- Без setfenv: script и require передаём параметрами функции.
		local Factory, LoadError = loadstring(
			"return function(script, require)\n" .. SourceText .. "\nend",
			"=" .. tostring(Module.Name))
		if not Factory then
			error("require(" .. tostring(Module.Name) .. "): " .. tostring(LoadError), 2)
		end
		local FactoryResult = Factory()
		if type(FactoryResult) ~= "function" then
			error("require(" .. tostring(Module.Name) .. "): failed to build module", 2)
		end
		Run = function()
			return FactoryResult(Module, LoadModule)
		end
	end

	-- pcall, а не xpcall: модули F3X уходят в yield прямо в require.
	local Ok, Result = pcall(Run)
	if not Ok then
		error("require(" .. tostring(Module.Name) .. ") failed: " .. tostring(Result), 2)
	end

	ModuleCache[Module], ModuleLoaded[Module] = Result, true
	ModulesLoaded += 1
	return Result
end

local Tool = build(TREE, nil)
resolveRefs()   -- StyleLink/StyleDerive → их StyleSheet
Tool.Name = "Building Tools by F3X (Fork3X)"
Tool.CanBeDropped = false

-- В оригинале эти значения выставляют DescendantCounter (сервер) и ReplicationListener (клиент).
local Loaded = Tool:FindFirstChild("Loaded")
if Loaded then
	local Counter = Loaded:FindFirstChild("DescendantCount")
	if Counter then
		Counter.Value = #Tool:GetDescendants()
	end
	Loaded.Value = true
end

-- Повторный запуск: убираем прошлую копию.
for _, Container in pairs({ Backpack, LocalPlayer.Character }) do
	if Container then
		local Old = Container:FindFirstChild(Tool.Name)
		if Old and Old ~= Tool then
			Old:Destroy()
		end
	end
end

Tool.Parent = Backpack

-- Локальный бэкенд: SyncAPI(OnInvoke) → SyncModule.PerformAction(игрок, ...)
local SyncAPI = Tool:WaitForChild("SyncAPI")

local function describeError(Err)
	if Err == nil then
		return "unknown error (nil)"
	end
	if type(Err) == "table" then
		Err = tostring(Err.Message or Err.message or Err)
	end
	return tostring(Err) .. "\n" .. debug.traceback("", 2)
end

-- pcall, а не xpcall: модули F3X уходят в yield прямо в require (Addons/LTSOptions),
-- а обработчик ошибок в xpcall такой yield ломает.
local SyncModuleOk, SyncModule = pcall(LoadModule, SyncAPI:WaitForChild("SyncModule"))

if not SyncModuleOk then
	warn("[F3X] SyncModule failed to load (building will not work): " .. tostring(SyncModule))
	SyncModule = nil
end

SyncAPI.OnInvoke = function(...)
	if not SyncModule then
		return nil
	end
	local Args = table.pack(...)
	-- PerformAction — обычная функция, не метод: первый аргумент это игрок.
	local Result = table.pack(pcall(SyncModule.PerformAction, LocalPlayer,
		table.unpack(Args, 1, Args.n)))
	if not Result[1] then
		warn("[F3X] Action error: " .. tostring(Result[2]))
		return nil
	end
	return Result[2]
end

-- Доступ к исходникам модулей (отладка и автотесты): в рантайме .Source не пишется.
rawset(_G, "F3XLocalSources", SOURCES)
rawset(_G, "Fork3XLocalSyncModule", SyncModule)
rawset(_G, "F3XLocalLoadMode", LOAD_MODE)
rawset(_G, "F3XLocalRequire", LoadModule)
rawset(_G, "F3XLocalModulesLoaded", ModulesLoaded)

-- Экспорт и запросы без сервера игры: пробуем HTTP экзекьютора.
local HttpService = game:GetService("HttpService")

local function executorRequest(spec)
	local genv = (type(getgenv) == "function" and getgenv()) or _G
	local request
	if type(genv.syn) == "table" and type(genv.syn.request) == "function" then
		request = genv.syn.request
	elseif type(genv.http_request) == "function" then
		request = genv.http_request
	elseif type(genv.request) == "function" then
		request = genv.request
	elseif type(genv.http) == "table" and type(genv.http.request) == "function" then
		request = genv.http.request
	elseif type(genv.fluxus) == "table" and type(genv.fluxus.request) == "function" then
		request = genv.fluxus.request
	elseif type(genv.krnl) == "table" and type(genv.krnl.request) == "function" then
		request = genv.krnl.request
	end
	if not request then
		return nil
	end
	local ok, response = pcall(request, spec)
	if ok then
		return response
	end
	return nil
end

local function setClipboard(text)
	local genv = (type(getgenv) == "function" and getgenv()) or _G
	local fn = genv.setclipboard or rawget(_G, "setclipboard")
	if type(fn) == "function" then
		pcall(fn, text)
		return true
	end
	return false
end

rawset(_G, "F3XLocalHttp", executorRequest)
rawset(_G, "F3XLocalSetClipboard", setClipboard)

local Exports = rawget(_G, "F3XLocalExports")
if type(Exports) ~= "table" then
	Exports = {}
end
rawset(_G, "F3XLocalExports", Exports)

-- Запускаем настоящее ядро Fork3X (Loader → Core → Tools → UI).
-- F3XLocalTestMode используется автотестами: ядро (и весь UI) в этом режиме не поднимается.
local Headless = rawget(_G, "F3XLocalTestMode")
local Ok, Result = true, nil

if not Headless then
	Ok, Result = pcall(LoadModule, Tool.Loader)
end

if not Headless and not Ok then
	warn("[F3X] Core failed to start: " .. tostring(Result))
elseif not Headless then
	-- Уведомления инструмента: дублируем в консоль, чтобы было видно, что происходит.
	pcall(function()
		local Core = LoadModule(Tool.Core)
		if Core.AddNotification then
			Core.AddNotification:Connect(function(Data)
				if type(Data) == "table" then
					print("[F3X] " .. tostring(Data.NoticeText or Data.Text or ""))
				end
			end)
		end
		rawset(_G, "Fork3XLocalCore", Core)

	end)

	local Attrs, AttrFail, Tags, TagFail, Styles, StyleFail = getCounters()
	print(string.format(
		"[F3X] Ready in %.2fs: %d objects, %d modules, %d properties, %d attributes, %d tags, %d styles (mode %s).",
		os.clock() - Started, #Tool:GetDescendants(), ModulesLoaded, FailedProperties,
		Attrs, Tags, Styles, LOAD_MODE
	))
	if AttrFail > 0 or TagFail > 0 or StyleFail > 0 then
		print(string.format(
			"[F3X] Not applied: %d attributes, %d tags, %d styles (the rest of the tree is still built).",
			AttrFail, TagFail, StyleFail
		))
	end
	print("[F3X] \"" .. Tool.Name .. "\" is in your Backpack — select it in the hotbar (1..9).")
	print("[F3X] Hotkeys: Z/X/C/V/B/N/M/K/J/H/G/F/U/P/L/T/Q/Y (same as Fork3X).")
	
	local UnionInfo = rawget(_G, "Fork3XLocalUnionInfo")
	if rawget(_G, "Fork3XLocalUnionSupported") == false then
		print("[F3X] Union/CSG is not available in this executor — Union buttons are disabled.")
		if UnionInfo and UnionInfo.Reason then
			print("[F3X] Union check: " .. tostring(UnionInfo.Reason))
		end
	elseif UnionInfo then
		print("[F3X] Union check passed: " .. tostring(UnionInfo.Reason or "geometry readable"))
	end
end

-- Используется Union-гейтом в SyncModule.
rawset(_G, "Fork3XLocalNotify", function(NoticeText, DetailText)
	print("[F3X] " .. tostring(NoticeText))
	pcall(function()
		local Core = rawget(_G, "Fork3XLocalCore")
		if Core and Core.AddNotification then
			Core.AddNotification:Fire({
				ThemeColor = Color3.new(1, 0.45, 0.15),
				NoticeText = NoticeText,
				DetailText = DetailText or "",
				TextXAlignment = Enum.TextXAlignment.Left,
			})
		end
	end)
end)

-- После респавна Backpack создаётся заново — возвращаем инструмент в инвентарь.
pcall(function()
	LocalPlayer.CharacterAdded:Connect(function()
		task.wait(1)
		local bag = LocalPlayer:FindFirstChildOfClass("Backpack")
		if bag and not Tool.Parent then
			Tool.Parent = bag
		end
	end)
end)

return Tool
