-- [F3X-LOCAL] Union support detection.
--
-- The reliable question is not "can I call GeometryService:UnionAsync" (it errors for
-- unrelated reasons and lies), but "can this executor read union geometry at all".
-- Same approach as UniversalSynSaveInstance:
--   1. find a real UnionOperation in the game (recursive, pcall-safe);
--   2. if the map has none, look in nil instances (getnilinstances);
--   3. read its AssetId through gethiddenproperty / get_hidden_property / get_hiddenprop;
--   4. if the value is not nil/"null"/"" and is longer than 5 chars, CSG is real;
--   5. only if there is nothing to read at all, fall back to a test union.
local UnionSupported = rawget(_G, "Fork3XLocalUnionSupported")

local function FireNotice(NoticeText, DetailText)
	local Notify = rawget(_G, "Fork3XLocalNotify")
	if Notify then
		pcall(Notify, NoticeText, DetailText)
	end
	warn("[F3X] " .. NoticeText)
end

local ProbeEnv = (type(getgenv) == "function" and getgenv()) or _G

local function GlobalFunction(...)
	for _, Name in ipairs({ ... }) do
		if type(ProbeEnv[Name]) == "function" then
			return ProbeEnv[Name]
		end
		if type(rawget(_G, Name)) == "function" then
			return rawget(_G, Name)
		end
	end
	return nil
end

local SCAN_LIMIT = 4000
local SCAN_BUDGET = 1

local function IsUnionOperation(Object)
	if Object == nil then
		return false
	end
	local Ok, ClassName = pcall(function()
		return Object.ClassName
	end)
	return Ok and ClassName == "UnionOperation"
end

-- Точки старта сканирования: сам DataModel плюс основные контейнеры.
-- Если game:GetChildren() недоступен (бывает в урезанных окружениях), идём по сервисам.
local function CollectRoots()
	local Roots = { game }
	for _, ServiceName in ipairs({ "Workspace", "Players", "ReplicatedStorage", "Lighting", "CoreGui", "StarterGui", "SoundService" }) do
		local Ok, Service = pcall(function()
			return game:GetService(ServiceName)
		end)
		if Ok and Service then
			Roots[#Roots + 1] = Service
		end
	end
	return Roots
end

-- Ищем юнион, не заходя в бесконечные ветки: обход в ширину, лимит и таймаут.
local function FindUnionOperation()
	local Visited, Deadline = 0, os.clock() + SCAN_BUDGET
	local Queue, Head = CollectRoots(), 1

	while Head <= #Queue and Visited < SCAN_LIMIT and os.clock() < Deadline do
		local Current = Queue[Head]
		Head += 1
		Visited += 1

		local Ok, Children = pcall(function()
			return Current:GetChildren()
		end)
		if Ok and type(Children) == "table" then
			for _, Child in ipairs(Children) do
				if IsUnionOperation(Child) then
					return Child, Visited
				end
				if #Queue < SCAN_LIMIT then
					Queue[#Queue + 1] = Child
				end
			end
		end
	end

	-- Удалённые из DataModel объекты живут в nil-инстансах.
	local GetNil = GlobalFunction("getnilinstances", "get_nil_instances")
	if GetNil then
		local OkNil, Nils = pcall(GetNil)
		if OkNil and type(Nils) == "table" then
			for _, Object in ipairs(Nils) do
				if IsUnionOperation(Object) then
					return Object, Visited
				end
				local OkChild, Found = pcall(function()
					return Object:FindFirstChildOfClass("UnionOperation", true)
				end)
				if OkChild and Found then
					return Found, Visited
				end
			end
		end
	end

	return nil, Visited
end

local function LooksLikeAssetId(Value)
	if Value == nil then
		return false
	end
	local Text = tostring(Value):lower()
	if Text == "" or Text == "null" or Text == "nil" then
		return false
	end
	if Text:find("null", 1, true) or Text:find("nil", 1, true) then
		return false
	end
	return #Text > 5
end

local function CanReadUnionGeometry(Union)
	local GetHidden = GlobalFunction("gethiddenproperty", "get_hidden_property", "get_hiddenprop")

	local function TryGet(GetterName, PropertyName)
		local Getter = GetHidden
		if GetterName then
			Getter = GlobalFunction(GetterName)
		end
		if not Getter then
			return nil
		end
		local Ok, Value = pcall(Getter, Union, PropertyName)
		if Ok and LooksLikeAssetId(Value) then
			return tostring(Value)
		end
		return nil
	end

	for _, PropertyName in ipairs({ "AssetId", "MeshId", "PhysicalConfigData" }) do
		local Value =
			TryGet("gethiddenproperty", PropertyName)
			or TryGet("get_hidden_property", PropertyName)
			or TryGet("get_hiddenprop", PropertyName)
			or TryGet(nil, PropertyName)
		if Value then
			return true, Value, PropertyName
		end
	end

	-- Свойство может быть открыто напрямую (редко, но бывает).
	local OkDirect, Direct = pcall(function()
		return Union.AssetId
	end)
	if OkDirect and LooksLikeAssetId(Direct) then
		return true, tostring(Direct), "AssetId"
	end

	return false, nil, nil
end

-- Крайний случай: в игре вообще нет юнионов. Пробуем создать тестовый.
local function CanCreateUnion()
	local Ok, Result = pcall(function()
		local GeometryService = game:GetService("GeometryService")
		local A = Instance.new("Part")
		local B = Instance.new("Part")
		A.Size, B.Size = Vector3.new(1, 1, 1), Vector3.new(1, 1, 1)
		A.Anchored, B.Anchored = true, true
		B.CFrame = A.CFrame * CFrame.new(0.5, 0, 0)
		local Union = GeometryService:UnionAsync(A, { B })
		local Worked = Union ~= nil
		if Union then
			pcall(function()
				Union:Destroy()
			end)
		end
		pcall(function()
			A:Destroy()
			B:Destroy()
		end)
		return Worked
	end)
	return Ok and Result == true
end

-- Возвращает таблицу с результатами: можно звать повторно для отладки.
local function ProbeUnion()
	local Info = {
		Supported = false,
		FoundUnion = false,
		CanReadGeometry = false,
		CanCreateUnion = false,
		AssetId = nil,
		Property = nil,
		Scanned = 0,
		Reason = nil,
	}

	local OkBody, Error = pcall(function()
		local Union, Visited = FindUnionOperation()
		Info.Scanned = Visited or 0
		Info.FoundUnion = Union ~= nil

		if Union then
			local CanRead, AssetId, Property = CanReadUnionGeometry(Union)
			Info.CanReadGeometry = CanRead
			Info.AssetId = AssetId
			Info.Property = Property
		end

		if not Info.CanReadGeometry then
			Info.CanCreateUnion = CanCreateUnion()
		end

		Info.Supported = Info.CanReadGeometry or Info.CanCreateUnion

		if Info.Supported then
			Info.Reason = Info.CanReadGeometry
				and ("executor can read union geometry (" .. tostring(Info.Property) .. " = " .. tostring(Info.AssetId) .. ")")
				or "executor can create unions through GeometryService"
		elseif Info.FoundUnion then
			Info.Reason = "found a UnionOperation, but its geometry (AssetId) is locked and union creation failed"
		else
			Info.Reason = "no UnionOperation in the game and union creation failed"
		end
	end)

	if not OkBody then
		Info.Reason = "probe crashed: " .. tostring(Error)
	end

	return Info
end

local function UnionIsSupported()
	local Global = rawget(_G, "Fork3XLocalUnionSupported")
	if Global ~= nil then
		return Global and true or false
	end
	return UnionSupported and true or false
end

local function RunProbe()
	if rawget(_G, "Fork3XLocalUnionInfo") ~= nil then
		return rawget(_G, "Fork3XLocalUnionInfo")
	end

	local Info = ProbeUnion()
	UnionSupported = Info.Supported
	rawset(_G, "Fork3XLocalUnionSupported", UnionSupported)
	rawset(_G, "Fork3XLocalUnionInfo", Info)
	if not Info.Supported then
		rawset(_G, "Fork3XLocalUnionReason", Info.Reason)
	end
	return Info
end

rawset(_G, "Fork3XLocalProbeUnion", function()
	rawset(_G, "Fork3XLocalUnionInfo", nil)
	rawset(_G, "Fork3XLocalUnionSupported", nil)
	return RunProbe()
end)

if UnionSupported == nil then
	RunProbe()
end

local UnionActions = { "CreateUnion", "OldCreateUnion", "SeparateUnion", "ConvertUnion" }

for _, Name in ipairs(UnionActions) do
	local Original = Actions[Name]
	if Original then
		Actions[Name] = function(...)
			if not UnionIsSupported() then
				local Info = rawget(_G, "Fork3XLocalUnionInfo")
				FireNotice(
					"Union is not available in this executor",
					"Union / Subtract / Separate need CSG, which this executor cannot use.\n"
						.. (Info and Info.Reason and ("Reason: " .. tostring(Info.Reason)) or "")
						.. "\n\nBuild from regular parts - the rest of Fork3X works fine."
				)
				return nil
			end
			local Ok, Result = pcall(Original, ...)
